# ── Civya runtime boundary ─────────────────────────────────────────
# Local contract development works without this file. Copy it to .env.local
# only when connecting a hosted sandbox or live provider. Never commit keys.

# development | test | staging | production
CIVYA_ENVIRONMENT=development
CIVYA_RELEASE_VERSION=local
CIVYA_CONFIG_VERSION=local-v1

# Credential-free provider fakes. Production categorically rejects this.
CIVYA_SYNTHETIC_MODE=true

# Voice response profile. Synthetic previews default to fast. Non-synthetic or
# production runtimes always force authoritative regardless of this value.
# fast = improved direct Realtime conversation
# legacy_fast = versioned July 14-style compatibility profile with current guards
# authoritative = transcript -> saved server turn -> approved speech
CIVYA_VOICE_MODE=fast

# JSON map from normalized host to tenant slug. Unknown hosts fail closed
# outside synthetic local development.
CIVYA_TENANT_HOSTS={"localhost":"wayne-county-demo","127.0.0.1":"wayne-county-demo"}

# Emergency controls. Production requires explicit values and a configured
# operational owner; setting pause-all prevents consequential actions.
CIVYA_PAUSE_ALL=false
CIVYA_ENABLE_RESIDENT_WEB=true
CIVYA_ENABLE_BROWSER_VOICE=true
CIVYA_ENABLE_PSTN=false
CIVYA_ENABLE_MESSAGES=false
CIVYA_ENABLE_DOCUMENT_SCANNING=false
CIVYA_ENABLE_HOSTED_HANDOFF=false
CIVYA_ENABLE_IDENTITY_PROOFING=false

# Required: OpenAI API key with Realtime API access (billing enabled).
OPENAI_API_KEY=sk-...

# Browser-voice Realtime model. There is no silent model downgrade; if it is
# unavailable, Civya preserves progress and explicitly offers text mode.
OPENAI_REALTIME_MODEL=gpt-realtime-2.1

# Browser-voice selection. The hosted sandbox accepts marin or cedar only.
OPENAI_REALTIME_VOICE=marin

# Embedding model used for the semantic (Layer 2) cache.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# synthetic keeps the deterministic resolver only; live uses a bounded
# Responses API classifier and can select only a pre-approved answer.
CIVYA_LANGUAGE_MODE=synthetic
OPENAI_INTENT_MODEL=gpt-5.6-luna

# Cosine-similarity threshold for a confident semantic cache hit (0..1).
CIVYA_CACHE_THRESHOLD=0.82

# Optional: Redis URL. Leave unset to use the in-memory store (default).
# REDIS_URL=redis://localhost:6379

# ── County-demo durable memory (Supabase) ──────────────────────────
# Public project values. Anonymous sign-in must be enabled in Supabase Auth.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key

# Server only. Used for health checks, tenant-scoped retention, invitation
# exchange, and other administrative jobs. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Versioned fictional tenant installed by supabase/seed/*.sql.
CIVYA_DEMO_TENANT_SLUG=wayne-county-demo

# HMAC secret for short-lived county demo-access cookies (32+ random bytes).
CIVYA_REQUIRE_DEMO_ACCESS=true
CIVYA_DEMO_ACCESS_SECRET=replace-with-a-long-random-secret
# Separate signing secret for the short-lived anonymous-to-email handoff.
CIVYA_AUTH_UPGRADE_SECRET=replace-with-a-different-long-random-secret
# Encrypts OAuth/passkey/recovery continuation state; keep distinct from every
# other signing secret.
CIVYA_AUTH_FLOW_SECRET=replace-with-a-distinct-long-random-secret
# Separate signing secret for the invited staff email-code challenge.
CIVYA_STAFF_AUTH_SECRET=replace-with-another-long-random-secret
# Signs short-lived direct-to-private-storage upload grants. In production this
# must be a fourth distinct 32+ byte key, never an auth-secret fallback.
CIVYA_DOCUMENT_UPLOAD_SECRET=replace-with-a-distinct-document-upload-secret

# Cloudflare Turnstile. Configure the matching secret in Supabase Dashboard →
# Auth → CAPTCHA so direct anonymous Auth calls are protected too. The hosted
# app fails closed until this operational setting is acknowledged.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
CIVYA_SUPABASE_CAPTCHA_ENFORCED=true

# Optional scheduled cleanup authentication for the 30-day retention job.
CRON_SECRET=replace-with-a-long-random-secret

# ── Provider adapters (optional until activated) ───────────────────
# disabled | synthetic | live. Production rejects synthetic adapters.
CIVYA_COUNTY_SOURCE_MODE=synthetic
CIVYA_MESSAGING_MODE=disabled
CIVYA_SCANNER_MODE=disabled
CIVYA_PAYMENT_HANDOFF_MODE=disabled
CIVYA_IDENTITY_PROOFING_MODE=disabled
CIVYA_TELEPHONY_MODE=disabled

# OAuth provider credentials are configured in Supabase Auth, not exposed to
# the browser. Apple secrets require their own rotation runbook.
CIVYA_AUTH_GOOGLE_ENABLED=false
CIVYA_AUTH_APPLE_ENABLED=false
CIVYA_AUTH_LINKEDIN_ENABLED=false
CIVYA_AUTH_PASSKEY_ENABLED=false
CIVYA_PUBLIC_ORIGIN=http://localhost:3000

# A signed-in account protects Civya progress but does not grant access to a
# County case. The County-approved verifier returns an opaque, scoped binding.
CIVYA_ENTITLEMENT_VERIFY_URL=
CIVYA_ENTITLEMENT_VERIFY_SECRET=
CIVYA_ENTITLEMENT_HUMAN_HELP=

# Durable worker operations. Live County source and reconciliation work remain
# disabled until their approved adapters/contracts are installed.
CIVYA_ENABLE_OUTBOX_DISPATCH=true
# Live resident reminders also require the worker capability
# outbox.reminder.delivery.requested. Keep it absent while messaging is off.
# CIVYA_WORKER_CAPABILITIES=foundation.healthcheck,foundation.outbox.dispatch,outbox.reminder.delivery.requested
CIVYA_ENABLE_COUNTY_SOURCE_WORKER=false
CIVYA_COUNTY_SOURCE_ENDPOINT=
CIVYA_COUNTY_SOURCE_CREDENTIAL=
CIVYA_ENABLE_PROVIDER_RECONCILIATION=false
CIVYA_RECONCILIATION_MODE=disabled
CIVYA_RECONCILIATION_ENDPOINT=
CIVYA_RECONCILIATION_CREDENTIAL=
CIVYA_RECONCILIATION_PROVIDER_KEY=

# Twilio / OpenAI SIP. The number routes to the OpenAI project SIP endpoint;
# webhook and call-control secrets remain server-side.
# phone_fast is the default low-latency phone profile: the full 2.1 model with
# Marin handles ordinary conversation and requests approved official facts.
CIVYA_PHONE_RESPONSE_MODE=phone_fast
CIVYA_PHONE_REALTIME_MODEL=gpt-realtime-2.1
CIVYA_PHONE_REALTIME_VOICE=marin
# Frontier fallback for current or obscure public questions. Search is limited
# to approved official and public-help domains and fails closed without sources.
OPENAI_OFFICIAL_RESEARCH_MODEL=gpt-5.6-sol
# Explicit rollback, never an automatic downgrade:
# CIVYA_PHONE_RESPONSE_MODE=renderer
# CIVYA_PHONE_REALTIME_MODEL=gpt-realtime-2.1-mini
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_SIP_TRUNK_SID=
OPENAI_PROJECT_ID=
OPENAI_WEBHOOK_SECRET=
CIVYA_CALL_CONTROL_BASE_URL=
CIVYA_WAYNE_TENANT_ID=
CIVYA_TWILIO_PHONE_NUMBER=
CIVYA_HUMAN_TRANSFER_URI=
# public admits any normal caller-ID-present number using a keyed digest only.
# canary is available for a named, pre-registered test cohort.
CIVYA_PSTN_ACCESS_MODE=public
CIVYA_CALL_RECORDING_MODE=disabled
# Used only when CIVYA_PSTN_ACCESS_MODE=canary. Values are E.164 numbers;
# Civya persists aliases and keyed digests, not the raw numbers.
CIVYA_PSTN_CANARY_TESTERS_JSON={}
CIVYA_PSTN_MAX_CONCURRENT_CALLS=2
CIVYA_PSTN_MAX_TURNS=20
# Public mode requires these explicit limits. Per-caller use is tracked only by
# a tenant-keyed HMAC digest; withheld/malformed caller IDs are not admitted.
CIVYA_PSTN_PUBLIC_CALLS_PER_HOUR=20
CIVYA_PSTN_MAX_DURATION_SECONDS=600
# Signed call-control -> Civya public-answer boundary. Keep both secrets unique.
CIVYA_PHONE_TURN_URL=
CIVYA_PHONE_TURN_SERVICE_SECRET=
CIVYA_PHONE_DIGEST_SECRET=

# Resident SMS reminders activate only when CIVYA_ENABLE_MESSAGES=true,
# CIVYA_MESSAGING_MODE=live, CIVYA_PUBLIC_ORIGIN is the exact public HTTPS
# origin, and CIVYA_TWILIO_WEBHOOK_URL is the exact signed callback URL. This
# messaging callback is not used for Elastic SIP call status. An
# approved Twilio sender/A2P registration, County-approved consent/template,
# STOP ownership, and a real delivery-receipt exercise are external launch
# requirements. Provider acceptance is never represented as delivery.

# The always-on call runtime uses this private endpoint to request a durable,
# one-time web-resume link. The issuer sends the SMS; no token is spoken aloud.
CIVYA_SECURE_LINK_ISSUER_URL=
CIVYA_INTERNAL_SERVICE_SECRET=
CIVYA_SECURE_LINK_SECRET=
CIVYA_TWILIO_WEBHOOK_URL=

# Hosted Wayne/Chase or DocuSign handoff. Civya stores no card/bank data.
CIVYA_HANDOFF_ALLOWED_ORIGINS=
# Separate 32+ byte encryption key for durable, single-use payment launch and
# advisory return links. Do not reuse an auth, webhook, or phone-link secret.
CIVYA_PAYMENT_LINK_SECRET=
JPM_CHECKOUT_BASE_URL=
JPM_CHECKOUT_CLIENT_ID=
JPM_CHECKOUT_CLIENT_SECRET=
# Exact County/J.P. Morgan-approved wire-contract version. Leaving this blank
# keeps the live adapter fail-closed; Civya does not guess provider schemas.
JPM_CHECKOUT_CONTRACT_VERSION=
JPM_CHECKOUT_WEBHOOK_SECRET=
DOCUSIGN_BASE_URL=
DOCUSIGN_WEBHOOK_SECRET=

# CLEAR1 stays disabled until a County-approved enterprise agreement exists.
CLEAR_OIDC_ISSUER=
CLEAR_CLIENT_ID=
CLEAR_CLIENT_SECRET=

# The always-on Render worker can receive the deliberately narrow OTLP JSON
# envelope emitted by Civya. The ingest key is a dedicated 32+ byte authority
# key shared only through the Render and Vercel secret stores; never reuse an
# auth, provider, webhook, upload, payment, or phone-link secret.
CIVYA_ENABLE_TELEMETRY_RECEIVER=false
CIVYA_TELEMETRY_INGEST_SECRET=

# Production uses the implemented OTLP HTTP/JSON adapter. Merely setting an
# endpoint or SENTRY_DSN does not satisfy readiness. The health probe sends a
# bounded, content-free log and requires a 2xx response from the receiver.
CIVYA_TELEMETRY_MODE=disabled
OTEL_EXPORTER_OTLP_ENDPOINT=
# Use this instead when the collector supplies an exact /v1/logs URL.
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=
# Declare the exact HTTPS origin when the endpoint is Civya's Render receiver.
# Runtime validation then requires /v1/logs and an ingest-key auth header.
CIVYA_TELEMETRY_RECEIVER_ORIGIN=
# Comma-separated, percent-encoded name=value entries; keep this server-only.
# Civya-owned example: x-civya-telemetry-key=<percent-encoded ingest key>
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=civya-web
CIVYA_TELEMETRY_TIMEOUT_MS=2000
